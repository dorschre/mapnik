PREFIX cg:   <https://w3id.org/cartograph#>
PREFIX cgp:  <https://w3id.org/cartograph-provenance#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ex:   <https://example.org/nuremberg/>

# CQ8: Retrieve display elements grouped by their topological anchor dimension (0D punctual, 1D linear, 2D areal)
SELECT ?element ?dimension ?placement ?anchorConcept ?drawOrder WHERE {
  ?element cg:inMap ex:tile_z17_44758 ;
           cg:anchorDimension ?dimension ;
           cg:placement ?placement ;
           cg:hasAnchorDimension ?anchorConcept ;
           cg:drawOrder ?drawOrder .
}
ORDER BY ?dimension ?drawOrder
