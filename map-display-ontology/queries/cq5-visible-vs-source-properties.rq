PREFIX cg:   <https://w3id.org/cartograph#>
PREFIX cgp:  <https://w3id.org/cartograph-provenance#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX ex:   <https://example.org/nuremberg/>

SELECT ?visibleLabel ?sourceWikidata ?sourceElevation WHERE {
  ?vo cg:representsFeature ex:feat_albrecht_duerer_haus ;
      cg:inMap ex:tile_z17_44758 ;
      cg:visibleLabel ?visibleLabel .
  ex:feat_albrecht_duerer_haus ex:wikidata ?sourceWikidata ;
                               ex:elevation ?sourceElevation .
}
