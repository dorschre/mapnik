@prefix ex:    <https://example.org/nuremberg/> .
@prefix cg:    <https://w3id.org/cartograph#> .
@prefix cgp:   <https://w3id.org/cartograph-provenance#> .
@prefix geo:   <http://www.opengis.net/ont/geosparql#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Intentionally invalid example:
# 1. MapImage missing canvasWidthPx and canvasHeightPx
# 2. VisibleObject without any hasDisplayedElement (an ungrounded ghost object)
# 3. DisplayElement without depictsFeature link

ex:invalid_map a cg:MapImage ;
    rdfs:label "Invalid Map Image" ;
    cg:zoomLevel 17.0 ;
    cg:crs "EPSG:3857" ;
    cg:viewportWkt "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))"^^geo:wktLiteral .

ex:ghost_visible_object a cg:VisibleObject ;
    rdfs:label "Ghost Visible Object (No Display Elements)" ;
    cg:inMap ex:invalid_map ;
    cg:representsFeature ex:feat_unrendered ;
    cg:visiblePixelCount 100 .

ex:feat_unrendered a geo:Feature ;
    rdfs:label "Unrendered Feature" ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT(0.5 0.5)"^^geo:wktLiteral ] .

ex:orphan_display_element a cg:LineElement ;
    rdfs:label "Orphan Display Element (No Feature Link & No Portrayal)" ;
    cg:inMap ex:invalid_map ;
    cg:pixelCount 50 ;
    cg:drawOrder 1 ;
    cg:isClipped false .
