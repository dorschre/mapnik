@prefix ex:    <https://example.org/nuremberg/> .
@prefix cg:    <https://w3id.org/cartograph#> .
@prefix cgp:   <https://w3id.org/cartograph-provenance#> .
@prefix geo:   <http://www.opengis.net/ont/geosparql#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

################################################################################
# Plans & Portrayal Specifications (PROV-O Plans)
################################################################################

ex:rule_primary_road_z17 a cgp:PortrayalRule, prov:Plan ;
    rdfs:label "Primary Road Style Rule z17" ;
    rdfs:comment "Specifies 7px casing stroke and 5px white fill for primary roads." ;
    dct:source <https://w3id.org/layout-engine/rule/osm-standard-z17/17-styles-z17.rq> .

ex:rule_hospital_symbol_z17 a cgp:PortrayalRule, prov:Plan ;
    rdfs:label "Hospital Icon Marker Rule z17" ;
    rdfs:comment "Assigns amenity-hospital icon marker to hospital features." ;
    dct:source <https://w3id.org/layout-engine/rule/osm-standard-z17/46-poi-styles-z17.rq> .

ex:policy_osm_carto_z17 a cgp:LayoutPolicy, prov:Plan ;
    rdfs:label "OSM Carto z17 Layout Policy" ;
    rdfs:comment "Governs label placement, collision rejection, and drawing order." ;
    dct:source <https://w3id.org/layout-engine/policy/osm-standard-z17/layout-policy.ttl> .

################################################################################
# Configuration, Resource Set, and Rendering Agents
################################################################################

ex:config_tile_44758 a cgp:MapConfiguration, prov:Entity ;
    rdfs:label "Map Configuration for Tile z17/69567/44758" ;
    cg:zoomLevel 17.0 ;
    cg:crs "EPSG:3857" ;
    cg:viewportWkt "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POLYGON ((11.071472 49.455628, 11.074219 49.455628, 11.074219 49.457413, 11.071472 49.457413, 11.071472 49.455628))"^^geo:wktLiteral .

ex:resource_set_z17 a cgp:ResourceSet, prov:Entity ;
    rdfs:label "OSM Standard z17 Graphical Resources" ;
    cgp:pinnedAsset "sha256:font-noto-sans-regular@6a3b" ;
    cgp:pinnedAsset "sha256:icon-amenity-hospital@2f9c" .

ex:agent_mapnik_agg a prov:Agent, prov:SoftwareAgent ;
    rdfs:label "Mapnik AGG Rendering Engine" .

ex:agent_cartograph a prov:Agent, prov:SoftwareAgent ;
    rdfs:label "CartoGraph SPARQL Layout Engine" .

################################################################################
# Rendered Map Image & Layers
################################################################################

ex:tile_z17_44758 a cg:MapImage ;
    rdfs:label "OpenStreetMap Standard Map Tile z17/69567/44758 (Nuremberg)" ;
    cg:canvasWidthPx 256 ;
    cg:canvasHeightPx 256 ;
    cg:zoomLevel 17.0 ;
    cg:crs "EPSG:3857" ;
    cg:viewportWkt "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POLYGON ((11.071472 49.455628, 11.074219 49.455628, 11.074219 49.457413, 11.071472 49.457413, 11.071472 49.455628))"^^geo:wktLiteral ;
    cg:backgroundColor "#f2efe9" ;
    cgp:usedPolicy ex:policy_osm_carto_z17 ;
    cgp:usedConfiguration ex:config_tile_44758 ;
    cgp:usedResources ex:resource_set_z17 ;
    prov:wasGeneratedBy ex:render_activity_tile_44758 .

ex:render_activity_tile_44758 a cgp:MapRenderingActivity, prov:Activity ;
    rdfs:label "Rendering Pass for Tile z17/69567/44758" ;
    prov:startedAtTime "2026-08-17T14:30:00Z"^^xsd:dateTime ;
    prov:endedAtTime   "2026-08-17T14:30:01Z"^^xsd:dateTime ;
    prov:used ex:feat_neutorstrasse, ex:feat_irrerstrasse, ex:feat_lammsgasse,
              ex:feat_kollisionsgasse, ex:feat_albrecht_duerer_haus,
              ex:feat_bratwursthaeusle, ex:feat_theresien_krankenhaus,
              ex:feat_emergency_clinic, ex:feat_frankenschnellweg ;
    prov:used ex:config_tile_44758 ;
    prov:used ex:resource_set_z17 ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent   ex:agent_mapnik_agg ;
        prov:hadPlan ex:rule_primary_road_z17
    ] , [
        a prov:Association ;
        prov:agent   ex:agent_mapnik_agg ;
        prov:hadPlan ex:rule_hospital_symbol_z17
    ] , [
        a prov:Association ;
        prov:agent   ex:agent_cartograph ;
        prov:hadPlan ex:policy_osm_carto_z17
    ] .

ex:layer_roads a cg:MapLayer ;
    cg:layerName "roads" ;
    cg:layerOrder 10 ;
    cg:inMap ex:tile_z17_44758 .

ex:layer_buildings a cg:MapLayer ;
    cg:layerName "buildings" ;
    cg:layerOrder 20 ;
    cg:inMap ex:tile_z17_44758 .

ex:layer_amenities a cg:MapLayer ;
    cg:layerName "amenities" ;
    cg:layerOrder 30 ;
    cg:inMap ex:tile_z17_44758 .

