################################################################################
# Visible Objects and Canvas DisplayElements with Visual Portrayals
################################################################################

# ==============================================================================
# 1. Neutorstraße (Cased Line Road + Curved Text Label)
# ==============================================================================

ex:vo_neutorstrasse a cg:VisibleObject ;
    rdfs:label "Visible Neutorstraße" ;
    cg:inMap ex:tile_z17_44758 ;
    cg:representsFeature ex:feat_neutorstrasse ;
    cg:inLayer ex:layer_roads ;
    cg:featureId "137191150" ;
    cg:visibleLabel "Neutorstraße" ;
    cg:visiblePixelCount 1420 ;
    cg:visiblePixelBbox "[34.4, 4.6, 196.2, 111.5]" ;
    cg:hasDisplayedElement ex:elem_neutor_casing, ex:elem_neutor_fill, ex:elem_neutor_text_line .

# Two independent LineElements carrying the casing and fill strokes of a cased
# line. The CasedLinePortrayal is a floating grouping whose components are
# carried by these two elements, enabling per-stroke pixel attribution and
# independent visibility (each stroke can be suppressed/occluded on its own).
ex:elem_neutor_casing a cg:LineElement ;
    rdfs:label "Neutorstraße casing stroke" ;
    cg:inMap ex:tile_z17_44758 ;
    cg:depictsFeature ex:feat_neutorstrasse ;
    prov:wasGeneratedBy ex:render_activity_tile_44758 ;
    prov:wasDerivedFrom ex:feat_neutorstrasse ;
    cgp:usedRule ex:rule_primary_road_z17 ;
    cg:partOfVisibleObject ex:vo_neutorstrasse ;
    cg:inLayer ex:layer_roads ;
    cg:anchorDimension 1 ;
    cg:placement "line" ;
    cg:hasAnchorDimension cg:CurveAnchor ;
    cg:drawOrder 10 ;
    cg:zIndex 20 ;
    cg:pixelCount 200 ;
    cg:isClipped false ;
    cg:pixelBbox "[34.4, 4.6, 196.2, 111.5]" ;
    cg:visibilityStatus cg:RenderedComplete ;
    cg:hasPortrayal ex:stroke_neutor_casing .

ex:elem_neutor_fill a cg:LineElement ;
    rdfs:label "Neutorstraße fill stroke" ;
    cg:inMap ex:tile_z17_44758 ;
    cg:depictsFeature ex:feat_neutorstrasse ;
    prov:wasGeneratedBy ex:render_activity_tile_44758 ;
    prov:wasDerivedFrom ex:feat_neutorstrasse ;
    cgp:usedRule ex:rule_primary_road_z17 ;
    cg:partOfVisibleObject ex:vo_neutorstrasse ;
    cg:inLayer ex:layer_roads ;
    cg:anchorDimension 1 ;
    cg:placement "line" ;
    cg:hasAnchorDimension cg:CurveAnchor ;
    cg:drawOrder 11 ;
    cg:zIndex 21 ;
    cg:pixelCount 1070 ;
    cg:isClipped false ;
    cg:pixelBbox "[34.4, 4.6, 196.2, 111.5]" ;
    cg:visibilityStatus cg:RenderedComplete ;
    cg:hasPortrayal ex:stroke_neutor_fill .

ex:portrayal_neutor_cased_line a cg:CasedLinePortrayal ;
    rdfs:label "Neutorstraße cased line portrayal" ;
    cg:hasCasingStroke ex:stroke_neutor_casing ;
    cg:hasFillStroke ex:stroke_neutor_fill ;
    cg:hasComponent ex:stroke_neutor_casing, ex:stroke_neutor_fill .

ex:stroke_neutor_casing a cg:StrokePortrayal ;
    rdfs:label "Neutorstraße outer casing stroke" ;
    cg:strokeColor "#c2b8ac" ;
    cg:strokeWidthPx 7.0 .

ex:stroke_neutor_fill a cg:StrokePortrayal ;
    rdfs:label "Neutorstraße inner fill stroke" ;
    cg:strokeColor "#ffffff" ;
    cg:strokeWidthPx 5.0 .

# 1D LineElement carrying a TextPortrayal (Curved text along street)
ex:elem_neutor_text_line a cg:LineElement ;
    rdfs:label "Neutorstraße curved text label line" ;
    cg:inMap ex:tile_z17_44758 ;
    cg:depictsFeature ex:feat_neutorstrasse ;
    cg:partOfVisibleObject ex:vo_neutorstrasse ;
    cg:inLayer ex:layer_roads ;
    cg:anchorDimension 1 ;
    cg:placement "line" ;
    cg:hasAnchorDimension cg:CurveAnchor ;
    cg:drawOrder 85 ;
    cg:zIndex 50 ;
    cg:pixelCount 150 ;
    cg:isClipped false ;
    cg:pixelBbox "[88.0, 95.0, 167.0, 105.0]" ;
    cg:visibilityStatus cg:RenderedComplete ;
    cg:hasPortrayal ex:portrayal_neutor_label .

ex:portrayal_neutor_label a cg:TextPortrayal ;
    rdfs:label "Neutorstraße text portrayal" ;
    cg:renderedText "Neutorstraße" ;
    cg:fontFamily "Noto Sans Regular" ;
    cg:fontSizePx 10.0 ;
    cg:textColor "#000000" ;
    cg:haloColor "#ffffff" ;
    cg:haloRadiusPx 2.0 .

